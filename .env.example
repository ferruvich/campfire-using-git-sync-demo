# Ngrok Configuration
# Get your authtoken from: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Static subdomain for ngrok (requires paid plan)
# Get your subdomain from: https://dashboard.ngrok.com/domains
# Format: https://your-subdomain.ngrok-free.app
NGROK_SUBDOMAIN=https://your-subdomain.ngrok-free.app

# GitHub Configuration for Git Sync
# Scenarios 1-5: create a Personal Access Token at https://github.com/settings/tokens
# Required scopes: repo, pull_requests, webhooks
# Scenario 6 uses a GitHub App instead and does not require GITHUB_PAT.
GITHUB_PAT=your_github_pat_here

# Your forked repository (full GitHub URL)
# Example: https://github.com/myusername/campfire-using-git-sync-demo
GITHUB_REPO=https://github.com/your_username/campfire-using-git-sync-demo

# Branch to sync (usually 'main')
GITHUB_BRANCH=main

# Scenario 6 only: install a GitHub App on the repository above.
# See 6-github-app/README.md for app creation, permissions, and installation.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# base64-encoded version of the private key
GITHUB_APP_PRIVATE_KEY=

# Scenario 6 user setup: used only when each account is first created.
# Set passwords locally before running 'mise run setup-users'.
GRAFANA_EDITOR_PASSWORD=
GRAFANA_VIEWER_PASSWORD=

# Note: This .env file is shared across all scenarios
# Free ngrok tier allows only 1 tunnel at a time
# Each scenario's docker-compose.yml will use this same token
